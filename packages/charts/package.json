{
  "name": "@trellis-ui/charts",
  "version": "0.1.0",
  "description": "Themed Recharts wrappers for Trellis UI: line, area, bar and donut charts.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@trellis-ui/react": "workspace:^",
    "recharts": "^3.10.1",
    "react-is": "^19.3.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "unrun": "^0.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "charts",
    "recharts",
    "dashboard"
  ]
}
