{
  "name": "@trellis-ui-pack/markdown",
  "version": "0.1.0",
  "description": "Streaming-friendly Markdown and code blocks for Trellis UI – made for AI chat answers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Piotr-Zacharski/trellis-ui.git",
    "directory": "packages/markdown"
  },
  "homepage": "https://github.com/Piotr-Zacharski/trellis-ui#readme",
  "bugs": "https://github.com/Piotr-Zacharski/trellis-ui/issues",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@trellis-ui-pack/react": "workspace:^",
    "react-aria-components": "^1.22.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sugar-high": "^2.6.4"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "unrun": "^0.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "markdown",
    "ai",
    "chat",
    "code-block"
  ]
}
